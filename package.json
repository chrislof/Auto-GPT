{
  "name": "mindpress",
  "version": "0.1.0",
  "private": true,
  "description": "MindPress — forward-deployed AI engineering. We put AI to work for you.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @mindpress/web",
    "build:web": "npm run build -w @mindpress/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
